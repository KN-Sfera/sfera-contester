{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Type checking only — nothing is emitted, so the rootDir from
    // tsconfig.json does not apply, and test/ sits next to src/.
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "test"],
  "exclude": []
}
