# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore.

# Podpisuje ciasteczka sesji. Min. 32 znaki. Zmiana wylogowuje wszystkich.
# Wygeneruj: openssl rand -base64 48
JWT_SECRET=

# open   — każdy może założyć konto
# invite — konta zakłada wyłącznie admin (tryb na konkurs)
# closed — rejestracja wyłączona
REGISTRATION_MODE=open

# true tylko za HTTPS. Lokalnie po HTTP musi zostać false, inaczej przeglądarka
# nie zapisze ciasteczka sesji.
COOKIE_SECURE=false
