# Copy to .env and fill in. The .env file is gitignored.

# Podpisuje ciasteczka sesji. Min. 32 znaki. Zmiana wylogowuje wszystkich.
# Wygeneruj: openssl rand -base64 48
JWT_SECRET=

# open   — anyone can create an account
# invite — only an admin creates accounts (contest mode)
# closed — registration is disabled
REGISTRATION_MODE=open

# true only behind HTTPS. Locally over HTTP it must stay false, or the browser
# nie zapisze ciasteczka sesji.
COOKIE_SECURE=false
